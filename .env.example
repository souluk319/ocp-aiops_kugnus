# Copy this file to .env.local and fill real local values.
# .env.local is gitignored and may contain local OpenShift credentials.

OPENSHIFT_API_SERVER=https://api.<cluster-domain>:6443
OPENSHIFT_INSECURE_SKIP_TLS_VERIFY=true
OPENSHIFT_NAMESPACE=<namespace>

# Prefer an already-valid `oc login` for local development.
# A static OPENSHIFT_TOKEN is not auto-refreshable; once it expires, replace it.
# OPENSHIFT_TOKEN=sha256~replace-with-token

# Optional local-only username/password relogin. `task fe:dev` uses this before a
# static token when the current `oc` session is invalid or the bridge health
# check returns 401/403.
# OPENSHIFT_USERNAME=<username>
# OPENSHIFT_PASSWORD=<password>

# Optional local-only auto-refresh hook. When the current oc session or console
# bridge API health check becomes Unauthorized, task fe:dev runs this command,
# verifies `oc whoami`, and restarts the local console bridge with the new token.
# Do not commit real credentials.
# OPENSHIFT_RELOGIN_COMMAND=oc login --token='<fresh-token-command-output>' --server=https://api.<cluster-domain>:6443 --insecure-skip-tls-verify=true

GATEWAY_ENDPOINT=http://localhost:18080
CONSOLE_PORT=9000
PLUGIN_PORT=9001
CONSOLE_TOKEN_CHECK_INTERVAL=60

# Backend dev mode override for `task be:dev`: read-only, execute, unrestricted.
# Kugnus catalog work defaults to read-only. Use execute/unrestricted only in a
# disposable lab after explicit approval.
# AIOPS_GATEWAY_MODE=read-only
# KOMSCO_AI_UNRESTRICTED_COMMAND_CWD=/root/project/ocp-aiops
# KOMSCO_AI_UNRESTRICTED_COMMAND_TIMEOUT_SECONDS=60

# Software Catalog / Helm chart repository workflow.
# KOMSCO_AIOPS_CATALOG_URL must be reachable by the OpenShift console/cluster.
# KOMSCO_AIOPS_CATALOG_URL=https://charts.example.internal/komsco-aiops
# KOMSCO_AIOPS_CHART_VERSION=0.1.3
# KOMSCO_AIOPS_APP_VERSION=0.1.3
# KOMSCO_AIOPS_NAMESPACE=komsco-ai
# KOMSCO_AIOPS_VALUES=/root/project/ocp-aiops/openshift/helm-values/console-plugin-prod.yaml

# Official OLM/OperatorHub workflow.
# These images must be reachable by the OpenShift cluster.
# Kugnus catalog-safe defaults. Do not reuse the existing shared
# ConsolePlugin/komsco-ai-console-plugin name for this project.
# KOMSCO_AIOPS_OPERATOR_VERSION=0.1.3
# KOMSCO_AIOPS_PACKAGE_NAME=komsco-aiops-kugnus
# KOMSCO_AIOPS_OLM_CATALOG_NAME=komsco-aiops-catalog-kugnus
# KOMSCO_AIOPS_OPERATOR_NAMESPACE=komsco-ai-kugnus
# KOMSCO_AIOPS_NAMESPACE=komsco-ai-kugnus
# KOMSCO_AIOPS_DISPLAY_NAME=Cywell AI
# KOMSCO_AIOPS_CONSOLE_PLUGIN_NAME=komsco-ai-console-plugin-kugnus
# KOMSCO_AIOPS_CONSOLE_PLUGIN_DISPLAY_NAME=Cywell AI
# KOMSCO_AIOPS_PROVIDER_NAME=Cywell
# KOMSCO_AIOPS_CATALOG_PUBLISHER=Cywell
# KOMSCO_AIOPS_MAINTAINER_NAME=Cywell Platform Team
# Defaults to docs/Ver.0.1.0/design-assets/K_icon.png when present.
# KOMSCO_AIOPS_ICON_FILE=docs/Ver.0.1.0/design-assets/K_icon.png
# KOMSCO_AIOPS_ICON_MEDIA_TYPE=image/png
# KOMSCO_AIOPS_OPERATOR_IMAGE=image-registry.openshift-image-registry.svc:5000/komsco-ai-kugnus/komsco-ai-gateway:0.1.3
# KOMSCO_AIOPS_PLUGIN_IMAGE=image-registry.openshift-image-registry.svc:5000/komsco-ai-kugnus/komsco-ai-console-plugin:0.1.3
# KOMSCO_AIOPS_GATEWAY_IMAGE=image-registry.openshift-image-registry.svc:5000/komsco-ai-kugnus/komsco-ai-gateway:0.1.3
# KOMSCO_AIOPS_PUSH_REGISTRY=default-route-openshift-image-registry.apps.example.com
# KOMSCO_AIOPS_PULL_REGISTRY=image-registry.openshift-image-registry.svc:5000
# KOMSCO_AIOPS_REGISTRY_TLS_VERIFY=false
# KOMSCO_AIOPS_CONTAINER_ENGINE=podman
# KOMSCO_AIOPS_MODE=read-only
# KOMSCO_AIOPS_ENABLE_MUTATIONS=false
# KOMSCO_AIOPS_ENABLE_UNRESTRICTED_COMMANDS=false
# KOMSCO_AIOPS_BOOTSTRAP_INSTALLATION=true
