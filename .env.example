# Copy this file to .env.local and fill real local values.
# .env.local is gitignored and may contain local OpenShift credentials.

OPENSHIFT_API_SERVER=https://api.<cluster-domain>:6443
OPENSHIFT_INSECURE_SKIP_TLS_VERIFY=true
OPENSHIFT_NAMESPACE=<namespace>

# Prefer an already-valid `oc login` for local development.
# A static OPENSHIFT_TOKEN is not auto-refreshable; once it expires, replace it.
# OPENSHIFT_TOKEN=sha256~replace-with-token

# Optional local-only username/password relogin. `task fe:dev` uses this before a
# static token when the current `oc` session is invalid or the bridge health
# check returns 401/403.
# OPENSHIFT_USERNAME=<username>
# OPENSHIFT_PASSWORD=<password>

# Optional local-only auto-refresh hook. When the current oc session or console
# bridge API health check becomes Unauthorized, task fe:dev runs this command,
# verifies `oc whoami`, and restarts the local console bridge with the new token.
# Do not commit real credentials.
# OPENSHIFT_RELOGIN_COMMAND=oc login --token='<fresh-token-command-output>' --server=https://api.<cluster-domain>:6443 --insecure-skip-tls-verify=true

GATEWAY_ENDPOINT=http://localhost:18080
CONSOLE_PORT=9000
PLUGIN_PORT=9001
CONSOLE_TOKEN_CHECK_INTERVAL=60

# Backend dev mode override for `task be:dev`: read-only, execute, unrestricted.
# Use unrestricted only in a disposable lab. It auto-executes supported natural
# language AIOps actions and enables explicit `/exec <command>` chat requests to
# run with the local Gateway process privileges.
# AIOPS_GATEWAY_MODE=read-only
# KOMSCO_AI_UNRESTRICTED_COMMAND_CWD=/root/project/ocp-aiops
# KOMSCO_AI_UNRESTRICTED_COMMAND_TIMEOUT_SECONDS=60
