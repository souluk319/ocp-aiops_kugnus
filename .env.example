# Sanitized example aligned with the current .env.
# Copy to .env.local only when you need overrides.
# Do not put real tokens, passwords, API keys, or database credentials here.

# OpenShift API
OPENSHIFT_API_SERVER=https://api.ocp.cywell.server:6443
OPENSHIFT_INSECURE_SKIP_TLS_VERIFY=true
OPENSHIFT_NAMESPACE=komsco-ai-kugnus

# Optional local relogin hook used by open-okd-console.sh/dev-console-plugin.sh.
# Prefer a normal `oc login` session. Do not store OpenShift bearer tokens here;
# the local console scripts read the current token at runtime with `oc whoami -t`.
# OPENSHIFT_RELOGIN_COMMAND='oc login https://api.ocp.cywell.server:6443 --web --insecure-skip-tls-verify=true'

# LLM provider used for final AIOps/RCA answers.
# Company default: OpenShift Lightspeed through a local port-forward.
KOMSCO_AI_LLM_PROVIDER=lightspeed
KOMSCO_AI_LLM_API_STYLE=lightspeed
KOMSCO_AI_LLM_BASE_URL=https://127.0.0.1:18443
KOMSCO_AI_LLM_TIMEOUT_SECONDS=300
OLS_CA_FILE=false

# Gateway RAG backend + embedding service
KOMSCO_AI_RAG_BACKEND_URL='postgresql://<user>:<password>@<host>:<port>/<database>'
KOMSCO_AI_EMBEDDING_PROVIDER=openai-compatible
KOMSCO_AI_EMBEDDING_API_STYLE=openai
KOMSCO_AI_EMBEDDING_BASE_URL=http://tei.cywell.co.kr/v1
KOMSCO_AI_EMBEDDING_MODEL=dragonkue/bge-m3-ko
KOMSCO_AI_EMBEDDING_DIMENSIONS=1024
KOMSCO_AI_EMBEDDING_TIMEOUT_SECONDS=15

# Local/home Ollama profile example. Use only when this machine can reach the model host.
# KOMSCO_AI_LLM_PROVIDER=ollama
# KOMSCO_AI_LLM_API_STYLE=ollama
# KOMSCO_AI_LLM_BASE_URL=http://100.99.152.52:11434
# KOMSCO_AI_LLM_MODEL=gemma4:12b-it-qat
# KOMSCO_AI_EMBEDDING_PROVIDER=ollama
# KOMSCO_AI_EMBEDDING_API_STYLE=ollama
# KOMSCO_AI_EMBEDDING_BASE_URL=http://100.99.152.52:11435
# KOMSCO_AI_EMBEDDING_MODEL=embeddinggemma:latest
# KOMSCO_AI_EMBEDDING_DIMENSIONS=768
# KOMSCO_AI_EMBEDDING_TIMEOUT_SECONDS=120
