# Sanitized example aligned with the current .env.
# Copy to .env.local only when you need overrides.
# Do not put real tokens, passwords, API keys, or database credentials here.

# OpenShift API
OPENSHIFT_API_SERVER=https://api.ocp.cywell.server:6443
OPENSHIFT_INSECURE_SKIP_TLS_VERIFY=true
OPENSHIFT_NAMESPACE=komsco-ai-kugnus

# Optional local relogin hook used by open-okd-console.sh/dev-console-plugin.sh.
# Prefer a normal `oc login` session. Do not store OpenShift bearer tokens here;
# the local console scripts read the current token at runtime with `oc whoami -t`.
# OPENSHIFT_RELOGIN_COMMAND='oc login https://api.ocp.cywell.server:6443 --web --insecure-skip-tls-verify=true'

# LLM provider used for final AIOps/RCA answers.
# Company default: OpenShift Lightspeed through a local port-forward.
KOMSCO_AI_LLM_PROVIDER=lightspeed
KOMSCO_AI_LLM_API_STYLE=lightspeed
KOMSCO_AI_LLM_BASE_URL=https://127.0.0.1:18443
KOMSCO_AI_LLM_TIMEOUT_SECONDS=300
OLS_CA_FILE=false

# Gateway RAG backend + embedding service
KOMSCO_AI_RAG_BACKEND_URL='postgresql://<user>:<password>@<host>:<port>/<database>'
KOMSCO_AI_EMBEDDING_PROVIDER=openai-compatible
KOMSCO_AI_EMBEDDING_API_STYLE=openai
KOMSCO_AI_EMBEDDING_BASE_URL=http://tei.cywell.co.kr/v1
KOMSCO_AI_EMBEDDING_MODEL=dragonkue/bge-m3-ko
KOMSCO_AI_EMBEDDING_DIMENSIONS=1024
KOMSCO_AI_EMBEDDING_TIMEOUT_SECONDS=15

# SWEET12 home model access.
# Use this profile only from machines logged in to the same Tailscale tailnet.
# Tailscale Serve/Funnel is only needed for non-tailnet public internet access.
# KOMSCO_AI_HOME_MODEL_BASE_URL=http://100.99.152.52
# KOMSCO_AI_HOME_LLM_BASE_URL=http://100.99.152.52:11434
# KOMSCO_AI_HOME_LLM_MODEL=gemma4:12b-it-qat
# KOMSCO_AI_HOME_EMBEDDING_BASE_URL=http://100.99.152.52:11435
# KOMSCO_AI_HOME_EMBEDDING_MODEL=embeddinggemma:latest
# KOMSCO_AI_HOME_EMBEDDING_DIMENSIONS=768

# Fallback LLM profile for "main LLM produced no final answer".
# Current Gateway code must be wired to consume KOMSCO_AI_FALLBACK_LLM_* before enabling.
# KOMSCO_AI_FALLBACK_LLM_ENABLED=false
# KOMSCO_AI_FALLBACK_LLM_PROVIDER=ollama
# KOMSCO_AI_FALLBACK_LLM_API_STYLE=ollama
# KOMSCO_AI_FALLBACK_LLM_BASE_URL=http://100.99.152.52:11434
# KOMSCO_AI_FALLBACK_LLM_MODEL=gemma4:12b-it-qat
# KOMSCO_AI_FALLBACK_LLM_TIMEOUT_SECONDS=120
# KOMSCO_AI_FALLBACK_LLM_TEMPERATURE=0.2
# KOMSCO_AI_FALLBACK_LLM_MAX_TOKENS=800

# Optional SWEET12 control API over Tailscale HTTPS gateway.
# Keep disabled until Tailscale Serve/Funnel is enabled on the tailnet.
# KOMSCO_AI_SWEET12_CONTROL_API_ENABLED=false
# KOMSCO_AI_SWEET12_CONTROL_BASE_URL=https://souluk.tail14d38e.ts.net
# KOMSCO_AI_SWEET12_CONTROL_STATUS_PATH=/api/home-server/status
# KOMSCO_AI_SWEET12_CONTROL_CHAT_PATH=/api/home-server/chat
# KOMSCO_AI_SWEET12_CONTROL_EMBED_PATH=/api/home-server/embed
# KOMSCO_AI_SWEET12_CONTROL_RAG_QUERY_PATH=/api/home-server/rag/query

# Standalone AIOps for OCP portal local proxy.
# Do not paste real bearer tokens into this tracked example.
AIOPS_GATEWAY_ORIGIN=http://127.0.0.1:18080
AIOPS_PORTAL_PORT=5173
# AIOPS_DEV_OPENSHIFT_TOKEN="$(oc whoami -t)"

# Same-tailnet Ollama direct runtime profile.
# Enable only when this machine can reach 100.99.152.52 directly.
# KOMSCO_AI_LLM_PROVIDER=ollama
# KOMSCO_AI_LLM_API_STYLE=ollama
# KOMSCO_AI_LLM_BASE_URL=http://100.99.152.52:11434
# KOMSCO_AI_LLM_MODEL=gemma4:12b-it-qat
# KOMSCO_AI_EMBEDDING_PROVIDER=ollama
# KOMSCO_AI_EMBEDDING_API_STYLE=ollama
# KOMSCO_AI_EMBEDDING_BASE_URL=http://100.99.152.52:11435
# KOMSCO_AI_EMBEDDING_MODEL=embeddinggemma:latest
# KOMSCO_AI_EMBEDDING_DIMENSIONS=768
# KOMSCO_AI_EMBEDDING_TIMEOUT_SECONDS=120
