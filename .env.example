# Copy this file to .env.local and fill real local values.
# .env.local is gitignored and may contain the real OpenShift token.

OPENSHIFT_API_SERVER=https://api.<cluster-domain>:6443
OPENSHIFT_TOKEN=sha256~replace-with-token
OPENSHIFT_INSECURE_SKIP_TLS_VERIFY=true
OPENSHIFT_NAMESPACE=<namespace>

GATEWAY_ENDPOINT=http://localhost:18080
CONSOLE_PORT=9000
PLUGIN_PORT=9001
CONSOLE_TOKEN_CHECK_INTERVAL=60
